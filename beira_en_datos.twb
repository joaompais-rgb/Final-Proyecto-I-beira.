  <datasources>
  <datasource caption="Contratos públicos de ropa (una fila por contrato)" inline='true' name='federated.contratos' version='18.1'>
    <connection class='federated'>
      <named-connections>
        <named-connection caption="contratos_tableau.csv" name='textscan.contratos'>
          <connection class='textscan' directory="C:/Users/Asus/Desktop/65_DATA_ANALYTICS_IRONHACK/beira-em-dados/tableau" filename="contratos_tableau.csv" password='' server='' />
        </named-connection>
      </named-connections>
      <relation connection='textscan.contratos' name="contratos_tableau.csv" table='[contratos_tableau#csv]' type='table'>
        <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='integer' name='idcontrato' ordinal='0' />
            <column datatype='integer' name='comprador_nif' ordinal='1' />
            <column datatype='string' name='proveedor_id' ordinal='2' />
            <column datatype='string' name='fecha' ordinal='3' />
            <column datatype='integer' name='ano' ordinal='4' />
            <column datatype='integer' name='mes' ordinal='5' />
            <column datatype='real' name='precio' ordinal='6' />
            <column datatype='string' name='producto' ordinal='7' />
            <column datatype='string' name='grupo' ordinal='8' />
            <column datatype='string' name='procedimiento' ordinal='9' />
            <column datatype='integer' name='plazo_dias' ordinal='10' />
            <column datatype='integer' name='competidores' ordinal='11' />
            <column datatype='string' name='ropa_fardamento' ordinal='12' />
            <column datatype='string' name='comprador' ordinal='13' />
            <column datatype='string' name='tipo_comprador' ordinal='14' />
            <column datatype='string' name='municipio' ordinal='15' />
            <column datatype='string' name='en_lista' ordinal='16' />
            <column datatype='string' name='tipo_proveedor' ordinal='17' />
            <column datatype='string' name='con_nif' ordinal='18' />
            <column datatype='string' name='distrito' ordinal='19' />
            <column datatype='string' name='piloto' ordinal='20' />
            <column datatype='real' name='poblacion' ordinal='21' />
            <column datatype='real' name='poblacion_5_24' ordinal='22' />
            <column datatype='real' name='km_a_la_base' ordinal='23' />
            <column datatype='real' name='lat' ordinal='24' />
            <column datatype='real' name='lon' ordinal='25' />
            <column datatype='string' name='ambito' ordinal='26' />
        </columns>
      </relation>
    </connection>
    <aliases enabled='yes' />
    <column caption="Contrato" datatype='integer' name='[idcontrato]' role='dimension' type='ordinal' />
    <column caption="Comprador (NIF)" datatype='integer' name='[comprador_nif]' role='dimension' type='ordinal' />
    <column datatype='string' name='[proveedor_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[fecha]' role='dimension' type='nominal' />
    <column caption="Año" datatype='integer' name='[ano]' role='dimension' type='ordinal' />
    <column caption="Mes" datatype='integer' name='[mes]' role='dimension' type='ordinal' />
    <column caption="Precio (€)" datatype='real' default-format='n#,##0' name='[precio]' role='measure' type='quantitative' />
    <column datatype='string' name='[producto]' role='dimension' type='nominal' />
    <column datatype='string' name='[grupo]' role='dimension' type='nominal' />
    <column caption="Procedimiento" datatype='string' name='[procedimiento]' role='dimension' type='nominal' />
    <column datatype='integer' name='[plazo_dias]' role='measure' type='quantitative' />
    <column caption="Competidores" datatype='integer' default-format='n#,##0.0' name='[competidores]' role='measure' type='quantitative' />
    <column caption="Ropa o fardamento" datatype='string' name='[ropa_fardamento]' role='dimension' type='nominal' />
    <column caption="Entidad" datatype='string' name='[comprador]' role='dimension' type='nominal' />
    <column caption="Tipo de comprador" datatype='string' name='[tipo_comprador]' role='dimension' type='nominal' />
    <column caption="Municipio" datatype='string' name='[municipio]' role='dimension' type='nominal' />
    <column datatype='string' name='[en_lista]' role='dimension' type='nominal' />
    <column datatype='string' name='[tipo_proveedor]' role='dimension' type='nominal' />
    <column datatype='string' name='[con_nif]' role='dimension' type='nominal' />
    <column datatype='string' name='[distrito]' role='dimension' type='nominal' />
    <column datatype='string' name='[piloto]' role='dimension' type='nominal' />
    <column datatype='real' name='[poblacion]' role='measure' type='quantitative' />
    <column datatype='real' name='[poblacion_5_24]' role='measure' type='quantitative' />
    <column caption="Km a la PAISAN" datatype='real' default-format='n#,##0' name='[km_a_la_base]' role='measure' type='quantitative' />
    <column caption="Latitud" datatype='real' name='[lat]' role='measure' type='quantitative' />
    <column caption="Longitud" datatype='real' name='[lon]' role='measure' type='quantitative' />
    <column caption="Ámbito" datatype='string' name='[ambito]' role='dimension' type='nominal' />
    <column caption="% de contratos de menos de 20.000 €" datatype='real' default-format='p0%' name='[Calculation_menos_20000]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="AVG(IIF([precio] &lt; 20000, 1, 0))" />
    </column>
    <column caption="% por ajuste directo" datatype='real' default-format='p0%' name='[Calculation_ajuste_directo]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='AVG(IIF([procedimiento] = "ajuste directo", 1, 0))' />
    </column>
    <column-instance column='[tipo_comprador]' derivation='None' name='[none:tipo_comprador:nk]' pivot='key' type='nominal' />
    <column-instance column='[ambito]' derivation='None' name='[none:ambito:nk]' pivot='key' type='nominal' />
    <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
    <style>
      <style-rule element='mark'>
        <encoding attr='color' field='[none:tipo_comprador:nk]' type='palette'><map to='#404020'><bucket>&quot;camara&quot;</bucket></map><map to='#96422c'><bucket>&quot;escuela&quot;</bucket></map><map to='#8f6226'><bucket>&quot;junta&quot;</bucket></map><map to='#9a958c'><bucket>&quot;otro&quot;</bucket></map><map to='#c9b79c'><bucket>&quot;bomberos&quot;</bucket></map></encoding>
        <encoding attr='color' field='[none:ambito:nk]' type='palette'><map to='#96422c'><bucket>&quot;región&quot;</bucket></map><map to='#9a958c'><bucket>&quot;resto del país&quot;</bucket></map></encoding>
      </style-rule>
    </style>
  </datasource>
