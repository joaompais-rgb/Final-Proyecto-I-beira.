  <dashboards>
    <dashboard name="1 · El mercado público de ropa">
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#ede5dc' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='5000' id='10' type-v2='text' w='98400' x='800' y='600'><formatted-text><run bold='true' fontcolor='#404020' fontsize='22'>¿Hay mercado para una marca pequeña de ropa personalizada?</run></formatted-text></zone>
          <zone h='4200' id='11' type-v2='text' w='98400' x='800' y='5600'><formatted-text><run fontcolor='#4a4a38' fontsize='12'>6.382 contratos públicos de ropa, 2020-2025 (Portal BASE). Región = los 66 municipios a menos de 100 km de la PAISAN. Los filtros de la derecha cambian todas las gráficas.</run></formatted-text></zone>
          <zone h='20000' id='12' name="KPI · Precio mediano" show-title='true' w='20000' x='800' y='11000' />
          <zone h='20000' id='13' name="KPI · Menos de 20.000 €" show-title='true' w='20000' x='21200' y='11000' />
          <zone h='20000' id='14' name="KPI · Ajuste directo" show-title='true' w='20000' x='41600' y='11000' />
          <zone h='20000' id='15' name="KPI · Competidores" show-title='true' w='19400' x='62000' y='11000' />
          <zone h='66000' id='16' name="Contratos por año" show-title='true' w='26400' x='800' y='32000' />
          <zone h='66000' id='17' name="Calendario" show-title='true' w='27000' x='27600' y='32000' />
          <zone h='66000' id='18' name="Cómo se compra" show-title='true' w='26400' x='55000' y='32000' />
          <zone h='8500' id='19' mode='checkdropdown' name="KPI · Precio mediano" param='[federated.contratos].[none:ambito:nk]' type-v2='filter' values='database' w='17200' x='82000' y='11000' />
          <zone h='8500' id='20' mode='checkdropdown' name="KPI · Precio mediano" param='[federated.contratos].[none:tipo_comprador:nk]' type-v2='filter' values='database' w='17200' x='82000' y='20000' />
          <zone h='8500' id='21' mode='checkdropdown' name="KPI · Precio mediano" param='[federated.contratos].[none:ropa_fardamento:nk]' type-v2='filter' values='database' w='17200' x='82000' y='29000' />
          <zone h='22000' id='22' name="Contratos por año" pane-specification-id='0' param='[federated.contratos].[none:tipo_comprador:nk]' type-v2='color' w='17200' x='82000' y='39000' />
        </zone>
      </zones>
    </dashboard>
    <dashboard name="2 · A quién dirigirse">
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#ede5dc' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='5000' id='10' type-v2='text' w='98400' x='800' y='600'><formatted-text><run bold='true' fontcolor='#404020' fontsize='22'>¿A quién se dirige la beira., cuándo y cómo?</run></formatted-text></zone>
          <zone h='4200' id='11' type-v2='text' w='98400' x='800' y='5600'><formatted-text><run fontcolor='#4a4a38' fontsize='12'>Las 63 entidades públicas de la región que compran ropa en dos años o más. Fiel = compró en 2025 y lleva tres años o más comprando. Los filtros de la derecha cambian todas las gráficas.</run></formatted-text></zone>
          <zone h='36000' id='12' name="Lista · Grupos" show-title='true' w='26400' x='800' y='11000' />
          <zone h='36000' id='13' name="Lista · Mes habitual" show-title='true' w='27000' x='27600' y='11000' />
          <zone h='36000' id='14' name="Lista · Cómo compran" show-title='true' w='26400' x='55000' y='11000' />
          <zone h='50000' id='15' name="Lista · Dónde están" show-title='true' w='36000' x='800' y='48000' />
          <zone h='50000' id='16' name="Lista · Entidades" show-title='true' w='44200' x='37200' y='48000' />
          <zone h='8500' id='17' mode='checkdropdown' name="Lista · Grupos" param='[federated.lista].[none:grupo_compra:nk]' type-v2='filter' values='database' w='17200' x='82000' y='11000' />
          <zone h='8500' id='18' mode='checkdropdown' name="Lista · Grupos" param='[federated.lista].[none:tipo_comprador:nk]' type-v2='filter' values='database' w='17200' x='82000' y='20000' />
          <zone h='8500' id='19' mode='checkdropdown' name="Lista · Grupos" param='[federated.lista].[none:compra_ropa_fardamento:nk]' type-v2='filter' values='database' w='17200' x='82000' y='29000' />
          <zone h='16000' id='20' name="Lista · Mes habitual" pane-specification-id='0' param='[federated.lista].[none:grupo_compra:nk]' type-v2='color' w='17200' x='82000' y='48000' />
          <zone h='18000' id='21' name="Lista · Grupos" pane-specification-id='0' param='[federated.lista].[none:tipo_comprador:nk]' type-v2='color' w='17200' x='82000' y='65000' />
        </zone>
      </zones>
    </dashboard>
      <dashboard name="Historia · beira. en datos" type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='430' />
