      <size maxheight='1060' maxwidth='1420' minheight='1060' minwidth='1420' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98490' id='1' param='vert' removable='false' type-v2='layout-flow' w='98874' x='563' y='755'>
            <zone h='3962' id='3' type-v2='title' w='98874' x='563' y='755' />
            <zone h='9528' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98874' x='563' y='4717' />
            <zone h='85000' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98874' x='563' y='14245'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption="1. Hay mercado: contratos pequeños, por ajuste directo y sin proveedor fijo" captured-sheet="1 · El mercado público de ropa" id='1' />
                  <story-point caption="2. A quién: 63 entidades que ya compran ropa, 34 de ellas fieles" captured-sheet="2 · A quién dirigirse" id='2' />
                  <story-point caption="3. Por dónde empezar: las fieles más cerca de la PAISAN" captured-sheet="2 · A quién dirigirse" id='3'>
                    <capturedDeltas>
                      <worksheet name='Lista · Cómo compran'>
                        <filter class='categorical' column='[federated.lista].[none:grupo_compra:nk]'>
                          <groupfilter function='member' level='[none:grupo_compra:nk]' member='&quot;A. fiel&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
                        </filter>
