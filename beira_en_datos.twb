  <worksheets>
    <worksheet name="KPI · Precio mediano">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#404020' fontsize='12'>Precio mediano del contrato (€)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Contratos públicos de ropa (una fila por contrato)" name='federated.contratos' />
          </datasources>
          <datasource-dependencies datasource='federated.contratos'>
            <column caption="Ámbito" datatype='string' name='[ambito]' role='dimension' type='nominal' />
            <column caption="Precio (€)" datatype='real' default-format='n#,##0' name='[precio]' role='measure' type='quantitative' />
            <column caption="Tipo de comprador" datatype='string' name='[tipo_comprador]' role='dimension' type='nominal' />
            <column caption="Ropa o fardamento" datatype='string' name='[ropa_fardamento]' role='dimension' type='nominal' />
            <column-instance column='[ambito]' derivation='None' name='[none:ambito:nk]' pivot='key' type='nominal' />
            <column-instance column='[precio]' derivation='Median' name='[med:precio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[tipo_comprador]' derivation='None' name='[none:tipo_comprador:nk]' pivot='key' type='nominal' />
            <column-instance column='[ropa_fardamento]' derivation='None' name='[none:ropa_fardamento:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.contratos].[none:ambito:nk]' filter-group='2'>
            <groupfilter function='level-members' level='[none:ambito:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.contratos].[none:tipo_comprador:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:tipo_comprador:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.contratos].[none:ropa_fardamento:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:ropa_fardamento:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices><column>[federated.contratos].[none:ambito:nk]</column><column>[federated.contratos].[none:tipo_comprador:nk]</column><column>[federated.contratos].[none:ropa_fardamento:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.contratos].[med:precio:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontcolor='#96422c' fontsize='28'>&lt;[federated.contratos].[med:precio:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols>[federated.contratos].[none:ambito:nk]</cols>
      </table>
    </worksheet>
